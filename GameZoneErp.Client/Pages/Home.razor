@page "/"
@inject NavigationManager Navigation

<PageTitle>GameZone ERP - Dashboard</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Welcome, Admin</h1>
            <p class="text-muted">Select a module to continue</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- POS Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-primary text-white shadow" @onclick='() => Navigation.NavigateTo("pos")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-cart-fill display-4 mb-3"></i>
                    <h3 class="card-title">POS</h3>
                    <p class="card-text">New Sale</p>
                </div>
            </div>
        </div>

        <!-- Sales History Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-success text-white shadow" @onclick='() => Navigation.NavigateTo("sales")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-receipt display-4 mb-3"></i>
                    <h3 class="card-title">History</h3>
                    <p class="card-text">View Sales</p>
                </div>
            </div>
        </div>

        <!-- Inventory Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-info text-white shadow" @onclick='() => Navigation.NavigateTo("inventory")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-box-seam display-4 mb-3"></i>
                    <h3 class="card-title">Inventory</h3>
                    <p class="card-text">Manage Items</p>
                </div>
            </div>
        </div>

        <!-- Partners Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-warning text-dark shadow" @onclick='() => Navigation.NavigateTo("partners")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-people-fill display-4 mb-3"></i>
                    <h3 class="card-title">Partners</h3>
                    <p class="card-text">CRM</p>
                </div>
            </div>
        </div>

        <!-- Users Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-secondary text-white shadow" @onclick='() => Navigation.NavigateTo("users")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-person-badge display-4 mb-3"></i>
                    <h3 class="card-title">Users</h3>
                    <p class="card-text">Manage Staff</p>
                </div>
            </div>
        </div>

        <!-- Z-Report Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-danger text-white shadow" @onclick='() => Navigation.NavigateTo("zreport")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-file-earmark-bar-graph display-4 mb-3"></i>
                    <h3 class="card-title">End of Day</h3>
                    <p class="card-text">Z-Report</p>
                </div>
            </div>
        </div>

        <!-- Settings Tile -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card dashboard-tile h-100 bg-dark text-white shadow" @onclick='() => Navigation.NavigateTo("settings")'>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-gear-fill display-4 mb-3"></i>
                    <h3 class="card-title">Settings</h3>
                    <p class="card-text">System Config</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-tile {
        cursor: pointer;
        transition: transform 0.2s;
    }
    .dashboard-tile:hover {
        transform: scale(1.05);
    }
</style>
